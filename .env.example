# Required secrets/settings
DISCORD_BOT_TOKEN=
BOT_DB_PATH=/absolute/path/to/zii/bot.db
LLM_MODEL=qwen
LLM_PROFILE_CONFIG=config/model_profiles.yaml

# Runtime timeouts and request settings.
LLM_TIMEOUT=180s
LLM_MAX_TOKENS=4096
# Optional request defaults; each is sent only when the selected profile supports it.
LLM_REASONING_EFFORT=
LLM_THINKING_BUDGET_TOKENS=0
LLM_MAX_CONCURRENCY=2
SEARCH_MCP_URL=http://127.0.0.1:8081/mcp
SEARCH_MCP_TIMEOUT=30s
MCP_MAX_CONCURRENCY=4

# Conversation and request limits
CONVERSATION_TTL=168h
CONVERSATION_MAX_TURNS=5
CONVERSATION_MAX_TOKENS=8192
TOOL_MAX_CALLS=3
SEARCH_LOCAL_MAX_CALLS=2
SEARCH_WEB_MAX_CALLS=1
FETCH_PAGE_MAX_CALLS=2
REQUEST_QUEUE_SIZE=10
QUEUE_WAIT_TIMEOUT=180s
REQUEST_TIMEOUT=300s

# Timezone for relative date/time answers (UTC or IANA name; default Asia/Tokyo; invalid or Local aborts startup)
APP_TIMEZONE=Asia/Tokyo

# Discord and logging
DISCORD_REPLY_MAX_CHARS=1900
DISCORD_SEND_MAX_RETRIES=3
LOG_LEVEL=info
